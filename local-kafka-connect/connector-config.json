{
  "name": "hudi-sink-local",
  "config": {
    "connector.class": "org.apache.hudi.connect.HoodieSinkConnector",
    "tasks.max": "1",
    "topics": "raw.telemetry",

    "bootstrap.servers": "redpanda:9092",
    "hoodie.kafka.control.topic": "hudi-control-local",
    "hoodie.kafka.commit.interval.secs": "120",
    "hoodie.kafka.bootstrap.servers": "redpanda:9092",

    "hoodie.table.name": "telemetry",
    "hoodie.table.type": "MERGE_ON_READ",
    "hoodie.base.path": "s3a://workshop-local/telemetry/",

    "hoodie.datasource.write.recordkey.field": "thing_name,message_timestamp",
    "hoodie.datasource.write.precombine.field": "message_timestamp",

    "hoodie.datasource.write.partitionpath.field": "message_timestamp",
    "hoodie.datasource.write.keygenerator.class": "org.apache.hudi.keygen.TimestampBasedAvroKeyGenerator",
    "hoodie.keygen.timebased.timestamp.type": "EPOCHMILLISECONDS",
    "hoodie.keygen.timebased.output.dateformat": "yyyy/MM/dd/HH",
    "hoodie.keygen.timebased.timezone": "UTC",

    "hoodie.schemaprovider.class": "org.apache.hudi.schema.FilebasedSchemaProvider",
    "hoodie.streamer.schemaprovider.source.schema.file": "/etc/hudi/telemetry.avsc",
    "hoodie.streamer.schemaprovider.target.schema.file": "/etc/hudi/telemetry.avsc",

    "hoodie.datasource.hive_sync.enable": "false",

    "hoodie.compact.inline": "true",
    "hoodie.compact.inline.max.delta.commits": "5"
  }
}
