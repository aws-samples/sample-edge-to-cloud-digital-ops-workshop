{
  "name": "edge-digital-ops-workshop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "sandbox": "bash scripts/sandbox.sh",
    "sandbox:all": "bash scripts/sandbox-all.sh",
    "sandbox:delete": "bash scripts/delete-slot.sh ${WORKSHOP_DEPLOYMENT_ID:-ws-slot00}",
    "sandbox:delete-all": "bash scripts/sandbox-delete-all.sh",
    "destroy:orphan-stack": "bash scripts/destroy-orphan-stack.sh",
    "detach:device-policy": "bash scripts/detach-device-policy.sh",
    "pipeline-deploy": "npx cdk deploy --app \"npx tsx amplify/custom/platform-app.ts\" --require-approval never WorkshopPlatformStack",
    "test": "node scripts/smoke-test.mjs",
    "e2e": "pnpm --filter edge-digital-ops-e2e test",
    "e2e:admin": "pnpm --filter edge-digital-ops-e2e test:admin",
    "e2e:participant": "pnpm --filter edge-digital-ops-e2e test:participant",
    "e2e:delete-platform-stack": "pnpm --filter edge-digital-ops-e2e test:delete-platform-stack"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.23.0",
    "@aws-amplify/backend-cli": "^1.8.3",
    "@types/node": "^25.9.2",
    "aws-cdk-lib": "^2.260.0",
    "constructs": "^10.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "aws-amplify": "^6.13.0"
  }
}
